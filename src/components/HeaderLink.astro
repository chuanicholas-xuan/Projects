---
import type { HTMLAttributes } from 'astro/types';

type Props = HTMLAttributes<'a'>;

const { href, class: className, ...props } = Astro.props;
// Compare the first path segment after the base, e.g. '/Projects/blog/x' -> 'blog'.
const section = (p: string) => p.replace(import.meta.env.BASE_URL, '').match(/[^/]+/)?.[0] ?? '';
const isActive = section(Astro.url.pathname) === section(String(href));
---

<a href={href} class:list={[className, { active: isActive }]} {...props}>
	<slot />
</a>
<style>
	a {
		display: inline-block;
		text-decoration: none;
	}
	a.active {
		font-weight: bolder;
		text-decoration: underline;
	}
</style>
